# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — Project Settings > API > service_role key.
# NEVER prefix this with NEXT_PUBLIC_. Used only in app/api/sync-github/route.ts
# to bypass RLS when writing synced projects.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub sync
GITHUB_USERNAME=ameeralimahar
# Optional but recommended — a GitHub personal access token (no scopes needed
# for public repos) raises the API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# A random secret string you generate yourself — protects /api/sync-github
# from being triggered by anyone who finds the URL. Vercel automatically
# sends this as a Bearer token when it fires the cron job, if this env var
# is set in your Vercel project settings.
CRON_SECRET=generate-a-long-random-string-here

# Admin dashboard — the single email address allowed to access /admin/*.
# Any magic-link sign-in from a different email is rejected server-side.
ADMIN_EMAIL=you@yourdomain.com

# Phase 3 AI features — Google Gemini API key (server-only, never NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key
